{
  "manifest_version": 3,
  "name": "Clify",
  "short_name": "Clify Official",
  "version": "7.0.0",
  "default_locale": "en",
  
  // AUTHORSHIP PROTECTION (IMMOVABLE)
  "author": "Dipto Design Studio | DiptoDesignStd@gmail.com | https://diptodesign.github.io/clifydl/",
  "developer": {
    "name": "Dipto Design Studio - Official Developer",
    "url": "https://diptodesign.github.io/clifydl/"
  },
  "homepage_url": "https://diptodesign.github.io/clifydl/",
  
  "description": "Open source YouTube content blocker. Take back control of your YouTube experience. by diptodesign",
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "notifications"
  ],
  
  "host_permissions": [
    "*://www.youtube.com/*",
    "https://diptodesign.github.io/clifydl/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "options_page": "dashboard.html",
  
  "action": {
    "default_title": "Clify Official - Dipto Design Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  
  "web_accessible_resources": [{
    "resources": ["icons/*", "dashboard.html"],
    "matches": ["<all_urls>"]
  }],
  
  // ADDITIONAL PROTECTION METADATA
  "version_name": "7.0.0-OFFICIAL-DD",
  "minimum_chrome_version": "88"
}